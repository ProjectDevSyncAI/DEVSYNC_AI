# ==========================================================
# DevSync AI — Environment Configuration
# ==========================================================

# Environment
NODE_ENV=development
APP_NAME=DevSync AI
API_PORT=3000
API_PREFIX=api
WEB_URL=http://localhost:5173

# Database (PostgreSQL + pgvector)
# Note: Docker maps host port 5440 -> container port 5432
DATABASE_URL=postgresql://devsync:devsync_password@localhost:5440/devsync?schema=public

# Redis Cache & BullMQ Queues
REDIS_URL=redis://localhost:6379

# Authentication (JWT)
JWT_SECRET=devsync-production-grade-jwt-secret-key-32-chars
JWT_EXPIRES_IN=7d

# Email Verification HMAC Secret
# Used to pseudonymize email addresses in Redis rate-limiting keys.
# REQUIRED in production: must be a cryptographically random string of at least 32 characters.
# Never reuse JWT_SECRET or any other application secret for this value.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_VERIFICATION_HMAC_SECRET=

# OpenAI LLM & Embeddings (Optional: Fallbacks will be used if empty)
OPENAI_API_KEY=your_openai_api_key_here
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini

# GitHub Integration & OAuth (Optional)
GITHUB_CLIENT_ID=Ov23liBXrcjQuVhfvCMy
GITHUB_CLIENT_SECRET=878e89fca623d901729f8e6041576da636128367
GITHUB_WEBHOOK_SECRET=devsync_webhook_secret_key
GITHUB_CALLBACK_URL=http://localhost:3000/api/github/callback

# Web Frontend (Vite)
VITE_API_URL=http://localhost:3000/api
VITE_SOCKET_URL=http://localhost:3000


EMAIL_VERIFICATION_REQUIRED=true


# Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=deepanshumittal080@gmail.com
SMTP_PASS=Deepanshu@2005
EMAIL_FROM=DevSync AI <deepanshumittal080@gmail.com>
